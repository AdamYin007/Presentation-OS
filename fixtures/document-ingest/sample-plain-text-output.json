      "sourceId": "para-000",
      "sourceType": "paragraph",
      "sourceOrder": 0,
      "originalText": "Q3 2026 Business Review",
      "sectionPath": [
        ""
      ],
      "confidence": 1,
      "fileReference": "sample-plain-text.txt",
      "origin": "sourced"
    },
    {
      "sourceId": "para-001",
      "sourceType": "paragraph",
      "sourceOrder": 2,
      "originalText": "Total revenue for Q3 2026 reached $42.5M, representing 18% year-over-year growth. The enterprise segment drove the majority of growth with 24% increase, while SMB segment grew 12%.",
      "sectionPath": [
        "REVENUE PERFORMANCE"
      ],
      "confidence": 1,
      "fileReference": "sample-plain-text.txt",
      "origin": "sourced"
    },
    {
      "sourceId": "para-002",
      "sourceType": "paragraph",
      "sourceOrder": 4,
      "originalText": "Customer acquisition cost decreased by 8% due to improved marketing efficiency. Monthly recurring revenue stabilized at $3.6M with a churn rate of 2.1%. Net revenue retention improved to 112%.",
      "sectionPath": [
        "KEY METRICS"
      ],
      "confidence": 1,
      "fileReference": "sample-plain-text.txt",
      "origin": "sourced"
    },
    {
      "sourceId": "para-003",
      "sourceType": "paragraph",
      "sourceOrder": 6,
      "originalText": "Released version 3.2 with enhanced dashboard analytics and improved mobile experience. Customer satisfaction score (CSAT) increased from 4.1 to 4.5 out of 5.0.",
      "sectionPath": [
        "PRODUCT UPDATES"
      ],
      "confidence": 1,
      "fileReference": "sample-plain-text.txt",
      "origin": "sourced"
    },
    {
      "sourceId": "para-004",
      "sourceType": "paragraph",
      "sourceOrder": 8,
      "originalText": "Increased competition in the mid-market segment. Supply chain delays affecting hardware-dependent product lines. Currency fluctuation impacting international revenue by approximately 3%.",
      "sectionPath": [
        "RISK FACTORS"
      ],
      "confidence": 1,
      "fileReference": "sample-plain-text.txt",
      "origin": "sourced"
    },
    {
      "sourceId": "para-005",
      "sourceType": "paragraph",
      "sourceOrder": 10,
      "originalText": "Expand sales team in APAC region. Launch new self-service onboarding flow. Invest in customer success to reduce churn below 2%.",
      "sectionPath": [
        "NEXT STEPS"
      ],
      "confidence": 1,
      "fileReference": "sample-plain-text.txt",
      "origin": "sourced"
    }
