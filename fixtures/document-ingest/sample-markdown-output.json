      "confidence": 1,
      "fileReference": "sample-markdown.md",
      "origin": "sourced"
    },
    {
      "sourceId": "para-005",
      "sourceType": "paragraph",
      "sourceOrder": 28,
      "originalText": "Project Phoenix represents a fundamental shift from our current reactive architecture to a proactive, event-driven system. The phased approach minimizes risk while delivering incremental value at each stage.",
