scripts/
*.test.js
*.test.cjs
*.spec.js
*.spec.cjs

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Environment
.env
.env.local
.env.production

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Build output
dist/
build/
coverage/
.nyc_output/

# API Gateway (standalone, not part of npm packages)
api-gateway/

# Web app (standalone, not part of npm packages)
packages/awe-app/

# Documentation site
docs-site/
