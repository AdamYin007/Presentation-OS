      "sourceParagraphs": [
        {
          "sourceId": "para-000",
          "originalText": "Project Phoenix is a next-generation distributed system designed to handle high-throughput event processing with guaranteed delivery and sub-second latency. This document outlines the architectural decisions, technology stack, and implementation roadmap.",
          "sectionPath": [
            "",
            "Project Phoenix: Technical Architecture Review",
            "Executive Summary"
          ]
        },
        {
          "sourceId": "para-001",
          "originalText": "Our existing monolithic architecture faces several critical limitations:",
          "sectionPath": [
            "",
            "Project Phoenix: Technical Architecture Review",
            "Current Challenges"
          ]
        }
      ]
    },
    {
